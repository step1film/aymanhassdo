# =====================================================
# STEP1 STORE — hemliga nycklar (MALL)
# =====================================================
# Kopiera INTE in riktiga värden i git. Denna fil är bara
# en mall. De riktiga värdena läggs som miljövariabler hos
# din hosting (Netlify: Site settings → Environment variables).
#
# För lokal test kan du kopiera denna fil till ".env" och köra
# `netlify dev`. Filen ".env" är git-ignorerad.
# =====================================================

# --- Sajtens adress (används för retur-URL:er och Swish-callback) ---
SITE_URL=https://step1film.se

# --- Printful (tryck + leverans) ---
# Skapa i Printful: Settings → Developers → API access tokens
PRINTFUL_API_TOKEN=

# Valfritt. Behövs bara om ditt konto har flera stores.
PRINTFUL_STORE_ID=

# 'true' = lägg skarpa (debiterade) ordrar automatiskt.
# Lämna tomt/false medan du testar → ordrar skapas som utkast.
PRINTFUL_CONFIRM_ORDERS=

# --- Stripe (kort + Klarna) ---
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → din endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# --- Swish Handel ---
# Ditt Swish-handelsnummer, t.ex. 1231234567
SWISH_PAYEE_ALIAS=
# Certifikatet (.p12) från banken, base64-kodat:
#   macOS/Linux:  base64 -i swish.p12 | tr -d '\n'
SWISH_CERT_P12=
# Lösenordet du satte när certifikatet skapades
SWISH_CERT_PASSWORD=
# 'test' använder Swish testmiljö (MSS), 'production' är skarpt
SWISH_ENV=test
