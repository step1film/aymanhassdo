# =====================================================
# STEP1 STORE — hemliga nycklar (MALL)
# =====================================================
# Kopiera INTE in riktiga värden i git. Denna fil är bara
# en mall. De riktiga värdena läggs som miljövariabler hos
# din hosting (Netlify: Site settings → Environment variables).
#
# För lokal test kan du kopiera denna fil till ".env" och köra
# `netlify dev`. Filen ".env" är git-ignorerad.
# =====================================================

# --- Adminsidan (step1film.se/admin) ---
# ADMIN_PASSWORD  lösenordet du loggar in med. Minst 20 tecken.
# ADMIN_SECRET    lång slumpsträng som signerar sessionen. Skrivs aldrig in.
# Byter du lösenord: byt BÅDA, annars fortsätter gamla inloggningar gälla.
# Se ADMIN_SETUP.md. Lämna tomma här — de riktiga värdena bor hos Netlify.
ADMIN_PASSWORD=
ADMIN_SECRET=

# --- Sajtens adress (dit kunden skickas tillbaka efter betalning) ---
# Detta är där BUTIKSSIDAN ligger, alltså det kunden ser i adressfältet.
SITE_URL=https://step1film.se

# --- Funktionernas adress (dit Swish ringer tillbaka) ---
# Behövs BARA om sajten och funktionerna ligger på olika värdar,
# t.ex. sajten på GitHub Pages och funktionerna på Netlify.
# Ligger allt på Netlify kan du lämna denna tom.
API_URL=https://step1film.netlify.app

# --- Adminnyckel ---
# Skyddar /printful-products, som listar hela din butik med priser
# och variant-ID:n. Utan denna är funktionen helt avstängd.
# Skapa en lång slumpsträng, t.ex.:  openssl rand -hex 32
ADMIN_KEY=

# --- Printful (tryck + leverans) ---
# Skapa i Printful: Settings → Developers → API access tokens
PRINTFUL_API_TOKEN=

# Valfritt. Behövs bara om ditt konto har flera stores.
PRINTFUL_STORE_ID=

# 'true' = lägg skarpa (debiterade) ordrar automatiskt.
# Lämna tomt/false medan du testar → ordrar skapas som utkast.
PRINTFUL_CONFIRM_ORDERS=

# --- Orderbekräftelse till kunden (Resend) ---
# Konto på resend.com → verifiera domänen step1film.se → API Keys.
# Saknas dessa skickas inget mejl alls — betalning och tryckorder
# fungerar ändå, och ordern loggas så du kan bekräfta för hand.
RESEND_API_KEY=
# Avsändaren kunden ser. Måste ligga på den verifierade domänen.
EMAIL_FROM=STEP1FILM STORE <shop@step1film.se>
# Valfritt: din egen dolda kopia av varje orderbekräftelse
EMAIL_BCC=shop@step1film.se
#
# Samma två nycklar driver också formuläret på startsidan (panel 05),
# som mejlar projektförfrågningar till collaboration@step1film.se.
# Utan dem svarar formuläret att e-post inte är påslaget och visar
# adressen i stället.

# --- Frakt ---
# Frakten hämtas live från Printful i kassan (functions/_lib/shipping.js).
# Svarar Printful inte — nätverksfel, timeout, driftstopp — tas det fasta
# priset i stället, så kassan aldrig stannar. Alla rader nedan är valfria;
# standardvärdena står i kommentaren.
#
# Reservpriset. Ska vara samma som "Standardfrakt" på frakt-leverans.html.  (79)
SHIPPING_FALLBACK_SEK=
# Fri frakt över detta ordervärde. Speglar shippingFreeOver i shop.js.     (1200)
SHIPPING_FREE_OVER_SEK=
# Spärr: högre frakt än så är ett fel och kapas. Används också av
# beloppskontrollerna i stripe-webhook och swish-complete.                  (199)
SHIPPING_MAX_SEK=
# Hur länge vi väntar på Printful innan reservpriset tas.                  (5000)
SHIPPING_TIMEOUT_MS=
# 'false' = fråga aldrig Printful, kör alltid fast pris.                   (true)
SHIPPING_LIVE=
# 'false' = låt live-priset gå över standardfrakten. Gör du det MÅSTE
# frakt-leverans.html skrivas om — sidan lovar högst 79 kr.                (true)
SHIPPING_CAP_TO_STANDARD=

# --- Stripe (kort + Klarna) ---
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → din endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
#
# BÅDA krävs. Med bara den hemliga nyckeln går betalningen igenom men
# webhooken kan inte verifiera Stripes signatur — kunden hade betalat
# utan att ordern skapades. Därför visas "Kort / Klarna" i kassan först
# när båda ligger på plats.
#
# Valfritt: vilka betalsätt Stripe ska visa. Tomt = card,klarna.
# Tillåtna: card, klarna, swish, link, paypal. Betalsättet måste vara
# påslaget i Stripe Dashboard, annars avvisar Stripe hela kassan.
# Stripe har egen Swish (SEK) — ett alternativ om du inte vill vänta
# på bankens certifikat. Se PAYMENTS_SETUP.md.
STRIPE_PAYMENT_METHODS=

# --- Swish Handel ---
# Ditt Swish-handelsnummer, t.ex. 1231234567
SWISH_PAYEE_ALIAS=1231540459
# Certifikatet (.p12) från banken, base64-kodat:
#   macOS/Linux:  base64 -i swish.p12 | tr -d '\n'
SWISH_CERT_P12=
# Lösenordet du satte när certifikatet skapades
SWISH_CERT_PASSWORD=
# 'test' använder Swish testmiljö (MSS), 'production' är skarpt
SWISH_ENV=test
#
# Swish visas i kassan först när SWISH_CERT_P12, handelsnumret och
# API_URL/SITE_URL alla finns. Butiken frågar servern via
# /.netlify/functions/payment-methods — ingen kodändring behövs när
# certifikatet kommer på plats.
